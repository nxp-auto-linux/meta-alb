From 0857aef044221a976395068a108c36a9a503fae2 Mon Sep 17 00:00:00 2001
From: Khristine Andreea Barbulescu <khristineandreea.barbulescu@nxp.com>
Date: Wed, 13 Nov 2024 14:51:55 +0200
Subject: [PATCH] tf-a: s32cc: Update dtsi to configure UART1 on EVB3

Issue: ALB-12251
Signed-off-by: Khristine Andreea Barbulescu <khristineandreea.barbulescu@nxp.com>
---
 fdts/s32gxxxa-evb.dtsi | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/fdts/s32gxxxa-evb.dtsi b/fdts/s32gxxxa-evb.dtsi
index d1924996d..5577b35f3 100644
--- a/fdts/s32gxxxa-evb.dtsi
+++ b/fdts/s32gxxxa-evb.dtsi
@@ -158,7 +158,7 @@
 	pinctrl-1 = <&i2c0_gpio_pins>;
 	scl-gpios = <&gpio 17 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
 	sda-gpios = <&gpio 16 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
-	status = "okay";
+	status = "disabled";
 };
 
 /* Platform board PCI X16 EXPRESS - I2C_SCL_S0, I2C_SDA_S0  */
@@ -500,7 +500,7 @@
 &uart1 {
 	pinctrl-0 = <&uart1_pins>;
 	pinctrl-names = "default";
-	status = "disabled";
+	status = "okay";
 };
 
 &pfe_mac0_rmii {
-- 
2.25.1

