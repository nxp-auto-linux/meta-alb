From 15fdca95a1913f810e13cd5688f64c95ad93642e Mon Sep 17 00:00:00 2001
From: Khristine Andreea Barbulescu <khristineandreea.barbulescu@nxp.com>
Date: Wed, 13 Nov 2024 15:08:57 +0200
Subject: [PATCH] linux: s32g: Update .dtsi to configure UART1 on EVB3

Issue: ALB-12251
Signed-off-by: Khristine Andreea Barbulescu <khristineandreea.barbulescu@nxp.com>
---
 arch/arm64/boot/dts/freescale/s32gxxxa-evb.dtsi | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/s32gxxxa-evb.dtsi b/arch/arm64/boot/dts/freescale/s32gxxxa-evb.dtsi
index a8f218555935..5e951db3e06d 100644
--- a/arch/arm64/boot/dts/freescale/s32gxxxa-evb.dtsi
+++ b/arch/arm64/boot/dts/freescale/s32gxxxa-evb.dtsi
@@ -754,7 +754,7 @@ &i2c0 {
 	pinctrl-1 = <&i2c0_gpio_pins>;
 	scl-gpios = <&gpio 17 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
 	sda-gpios = <&gpio 16 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
-	status = "okay";
+	status = "disabled";
 };
 
 &i2c1 {
@@ -991,5 +991,5 @@ &uart0 {
 &uart1 {
 	pinctrl-0 = <&uart1_pins>;
 	pinctrl-names = "default";
-	status = "disabled";
+	status = "okay";
 };
-- 
2.25.1

